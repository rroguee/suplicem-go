{
  "expo": {
    "name": "suplicem-go",
    "slug": "suplicem-go",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo2.png",
    "scheme": "suplicemgo",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "location"
        ],
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Suplicem necesita tu ubicación en segundo plano para rastrear el trayecto del camión hacia el cliente.",
        "NSLocationWhenInUseUsageDescription": "Suplicem necesita tu ubicación para rastrear el trayecto de la entrega.",
        "NSCameraUsageDescription": "Suplicem necesita acceso a la cámara para tomar fotos de comprobantes de pago y documentos de identidad.",
        "NSPhotoLibraryUsageDescription": "Suplicem necesita acceso a la galería para seleccionar comprobantes de pago y documentos de identidad."
      }
    },
    "android": {
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBw1kZRLkbF4L9Q-q_SkUvh8bdf2cjJfck"
        }
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.enfoco.suplicemgo",
      "versionCode": 1,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 250,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Suplicem necesita tu ubicación en segundo plano para rastrear el trayecto del camión hacia el cliente.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": false
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Suplicem necesita acceso a tus fotos para adjuntar comprobantes de transferencia e identificación.",
          "cameraPermission": "Suplicem necesita acceso a tu cámara para capturar comprobantes de pago y cédula."
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-web-browser",
      "expo-asset",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "02ff6cc6-d22b-416a-b492-94e5069c38e5"
      }
    },
    "owner": "rroguee"
  }
}
